# Optional build-time override for the worldwide development basemap.
# Use "off" for a graph-only startup. Public hosting requires a reviewed provider or versioned self-hosted assets.
NEXT_PUBLIC_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_BASEMAP_ATTRIBUTION=OpenFreeMap © OpenMapTiles · Data © OpenStreetMap contributors

# Optional Mapzen Terrarium DEM from the AWS Open Data Registry. Terrain stays disabled when this is unset.
# The composite has location-specific attribution; preserve the complete provider record documented in the repository.
NEXT_PUBLIC_TERRAIN_TILES_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png
NEXT_PUBLIC_TERRAIN_ATTRIBUTION=Mapzen terrain tiles · Canada data licensed under the Open Government Licence – Canada · Full source attributions: github.com/tilezen/joerd/blob/master/docs/attribution.md

# Optional repository-relative or absolute local artifact overrides.
VECTORSHIFT_GRAPH_PATH=data/derived/osm-2026-11-05-pipeline3.road-graph.json
VECTORSHIFT_ROUTING_SUPPORT_PATH=data/derived/osm-2026-11-05-pipeline3.routing-support.json
VECTORSHIFT_GRAPH_MANIFEST_PATH=data/manifests/toronto-downtown-2026-11-05-pipeline3.json
VECTORSHIFT_GRAPH_SHA256=c12c4523e0b43725d6ad843816593395b6a0e780408c8009dc928756105c6573
VECTORSHIFT_ROUTING_SUPPORT_SHA256=a4b8c49ec359cad6b70e947b012e6e01f8d0b984b2d066f734c61666fe362eae

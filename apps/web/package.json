{
  "name": "@vectorshift/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "next typegen && tsc --noEmit --project tsconfig.json",
    "test": "node --test test/*.test.ts",
    "test:e2e": "playwright test",
    "benchmark:api": "node benchmark/local-api-benchmark.ts",
    "benchmark:browser": "node benchmark/browser-interaction-benchmark.ts",
    "visual:verify": "node benchmark/capture-visual-evidence.ts"
  },
  "dependencies": {
    "maplibre-gl": "6.16.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/geojson": "7946.0.16",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}

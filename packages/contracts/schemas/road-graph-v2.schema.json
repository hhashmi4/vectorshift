{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vectorshift.dev/schemas/road-graph-v2.schema.json",
  "title": "VECTORSHIFT road graph artifact v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_version", "graph_sha256", "graph"],
  "properties": {
    "artifact_version": { "const": 1 },
    "graph_sha256": { "$ref": "#/$defs/sha256" },
    "graph": { "$ref": "#/$defs/graph" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/%+-]*$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "mode": { "enum": ["motor_vehicle", "bicycle", "pedestrian"] },
    "modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/mode" }
    },
    "coordinate": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": -1800000000, "maximum": 1800000000 },
        { "type": "integer", "minimum": -900000000, "maximum": 900000000 }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["south_e7", "west_e7", "north_e7", "east_e7"],
      "properties": {
        "south_e7": { "type": "integer", "minimum": -900000000, "maximum": 900000000 },
        "west_e7": { "type": "integer", "minimum": -1800000000, "maximum": 1800000000 },
        "north_e7": { "type": "integer", "minimum": -900000000, "maximum": 900000000 },
        "east_e7": { "type": "integer", "minimum": -1800000000, "maximum": 1800000000 }
      }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "source_id"],
      "properties": {
        "namespace": { "$ref": "#/$defs/identifier" },
        "source_id": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "sourceMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "source_uri", "license", "attribution", "acquired_at", "snapshot_at", "bounds", "source_sha256", "pipeline_version"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "source_uri": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "attribution": { "type": "string", "minLength": 1 },
        "acquired_at": { "type": "string", "format": "date-time" },
        "snapshot_at": { "type": "string", "format": "date-time" },
        "bounds": { "$ref": "#/$defs/bounds" },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "pipeline_version": { "$ref": "#/$defs/identifier" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "coordinate_e7", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "coordinate_e7": { "$ref": "#/$defs/coordinate" },
        "source": { "$ref": "#/$defs/sourceReference" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_node_id", "target_node_id", "source_segment_id", "hierarchy", "modes", "length_mm", "traversal_time_ms_by_mode", "geometry_e7"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "source_node_id": { "$ref": "#/$defs/identifier" },
        "target_node_id": { "$ref": "#/$defs/identifier" },
        "source_segment_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "hierarchy": { "enum": ["motorway", "trunk", "primary", "secondary", "tertiary", "residential", "service", "living_street", "path", "other"] },
        "modes": { "$ref": "#/$defs/modes" },
        "length_mm": { "type": "integer", "minimum": 1 },
        "traversal_time_ms_by_mode": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "motor_vehicle": { "type": "integer", "minimum": 0 },
            "bicycle": { "type": "integer", "minimum": 0 },
            "pedestrian": { "type": "integer", "minimum": 0 }
          }
        },
        "geometry_e7": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/coordinate" } }
      }
    },
    "turnRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "via_node_id", "from_edge_id", "to_edge_id", "modes", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "via_node_id": { "$ref": "#/$defs/identifier" },
        "from_edge_id": { "$ref": "#/$defs/identifier" },
        "to_edge_id": { "$ref": "#/$defs/identifier" },
        "modes": { "$ref": "#/$defs/modes" },
        "kind": { "enum": ["forbidden", "penalty"] },
        "penalty_ms": { "type": "integer", "minimum": 1 }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "schema_version", "dataset", "crs", "nodes", "edges", "turn_rules"],
      "properties": {
        "format": { "const": "vectorshift-road-graph" },
        "schema_version": { "const": 2 },
        "dataset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dataset_id", "dataset_version", "source"],
          "properties": {
            "dataset_id": { "$ref": "#/$defs/identifier" },
            "dataset_version": { "$ref": "#/$defs/identifier" },
            "source": { "$ref": "#/$defs/sourceMetadata" }
          }
        },
        "crs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identifier", "axis_order", "coordinate_scale"],
          "properties": {
            "identifier": { "const": "EPSG:4326" },
            "axis_order": { "const": "longitude-latitude" },
            "coordinate_scale": { "const": 10000000 }
          }
        },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
        "turn_rules": { "type": "array", "items": { "$ref": "#/$defs/turnRule" } }
      }
    }
  }
}
